{
    "target": "esp32s3",
    "builds": [
        {
            "name": "echoear",
            "sdkconfig_append": [
                "CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y",
                "CONFIG_DISABLE_AUTO_OTA=y",
                "CONFIG_GFX_FONT_FREETYPE_SUPPORT=y",
                "CONFIG_PARTITION_TABLE_CUSTOM=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v1/16m_echoear.csv\"",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"xiao zhi xiao zhi\"",
                "CONFIG_CUSTOM_WAKE_WORD_ALTERNATE=\"xiao zi xiao zi\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"小智小智\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=50",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n",
                "CONFIG_SR_WN_WN9_NIHAOMIAOBAN_TTS2=n",
                "CONFIG_SR_WN_WN9_XIAOAITONGXUE=n",
                "CONFIG_SR_MN_CN_NONE=n",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_USE_DEVICE_AEC=n"
            ]
        }
    ]
}
